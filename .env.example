# BillBook environment variables
# Copy this file to .env and fill in your values.
# NOTE: The .env file is NEVER shipped with the Windows installer.
#       End users set APP_PASSWORD on first launch via the setup wizard,
#       OR set it as a Windows environment variable before first run.

# Initial admin password (min 8 chars). Used only on first startup to seed
# the DB. After first run, change password via the Settings UI.
# "change-me-now" and other obvious defaults are REFUSED on first startup.
APP_PASSWORD=please-change-this-to-a-real-password

# Optional: AI provider keys via env (you can also add providers in Settings UI)
GEMINI_API_KEY=
OPENROUTER_KEY=
GROQ_KEY=

# NOTE: SESSION_SECRET line was removed in v8.13.3 — the cookie-signing
# secret is now derived from the operator's password hash, eliminating a
# footgun where an accidentally-defaulted SESSION_SECRET weakened cookies.

# v8.14.0: Google Drive cloud backup OAuth client
# Get these from https://console.cloud.google.com/apis/credentials
# (Create an OAuth 2.0 Client ID for a "Desktop" app; the client_id + secret
#  ship with the installer — clients authorize their OWN Google Drive, the
#  app only sees files it creates, never the user's other Drive files.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GDRIVE_REDIRECT_URI=http://localhost:8000/api/gdrive/callback

# v8.14.0: Data at rest encryption (SQLCipher)
# Leave empty to run in plaintext SQLite (backwards-compat).
# Set to a strong passphrase (32+ random chars) to enable AES-256 encryption
# of the entire billbook.db — required for production deployments where
# customer PII must be protected if the disk is stolen.
# The recommended approach is to leave this empty and instead set the key
# via Settings > Security > Enable DB Encryption (which derives the key
# from the manager's password hash + a persisted random salt).
BILLBOOK_DB_KEY=
