{
  "appId": "com.billbook.app",
  "appName": "BillBook",
  "webDir": "www",
  "server": {
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "backgroundColor": "#0F172A",
      "showSpinner": false
    }
  }
}
